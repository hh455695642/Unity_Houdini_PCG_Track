{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcgbike-change-manifest-v1",
  "title": "PCG Bike regression change manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "module",
    "allowed_files",
    "allowed_nodes",
    "allowed_added_nodes",
    "allowed_removed_nodes",
    "allowed_connections",
    "allowed_parameters",
    "allowed_public_parameters",
    "allow_output_changes",
    "required_contracts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task": { "type": "string", "minLength": 1 },
    "module": { "enum": ["CityRoad", "Track", "Terrain", "StreetBuilding"] },
    "asset_path": {
      "type": "string",
      "pattern": "^/obj/",
      "description": "Optional explicit Live Scene asset path. Use only when the canonical path is absent."
    },
    "allowed_files": { "$ref": "#/$defs/patterns" },
    "allowed_nodes": { "$ref": "#/$defs/patterns" },
    "allowed_added_nodes": { "$ref": "#/$defs/patterns" },
    "allowed_removed_nodes": { "$ref": "#/$defs/patterns" },
    "allowed_connections": { "$ref": "#/$defs/patterns" },
    "allowed_parameters": {
      "$ref": "#/$defs/patterns",
      "description": "Patterns use <node-relative-path>:<parm-name>."
    },
    "allowed_public_parameters": {
      "$ref": "#/$defs/patterns",
      "description": "Patterns use the nested public parameter template path."
    },
    "allow_output_changes": { "type": "boolean" },
    "allowed_warning_signatures": { "$ref": "#/$defs/patterns", "default": [] },
    "required_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "patterns": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
