#pragma kernel CullCityParkInstances
#pragma kernel CullCityParkChunks

struct CityParkInstance
{
    float4x4 localToWorld;
    int variant;
    int chunk;
};

struct CityParkChunk
{
    float3 center;
    float3 extents;
};

StructuredBuffer<CityParkInstance> _Instances;
StructuredBuffer<CityParkChunk> _Chunks;
RWStructuredBuffer<uint> _ChunkVisibility;
AppendStructuredBuffer<float4x4> _VisibleLod0;
AppendStructuredBuffer<float4x4> _VisibleLod1;

float4 _FrustumPlanes[6];
float3 _CameraPositionWS;
float _Lod0Distance;
float _MaximumDistance;
float _BoundingRadius;
int _InstanceCount;
int _ChunkCount;
int _TargetVariant;

bool IsVisible(float3 positionWS, float radius)
{
    [unroll]
    for (int index = 0; index < 6; index++)
    {
        if (dot(_FrustumPlanes[index].xyz, positionWS)
            + _FrustumPlanes[index].w < -radius)
            return false;
    }
    return true;
}

[numthreads(64, 1, 1)]
void CullCityParkChunks(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ChunkCount)
        return;

    CityParkChunk chunk = _Chunks[index];
    float radius = length(chunk.extents) + _BoundingRadius;
    float distanceToCamera = distance(chunk.center, _CameraPositionWS);
    _ChunkVisibility[index] = distanceToCamera <= _MaximumDistance + radius
        && IsVisible(chunk.center, radius) ? 1u : 0u;
}

[numthreads(64, 1, 1)]
void CullCityParkInstances(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_InstanceCount)
        return;

    CityParkInstance instance = _Instances[index];
    if (instance.variant != _TargetVariant
        || _ChunkVisibility[instance.chunk] == 0u)
        return;

    float3 positionWS = instance.localToWorld._m03_m13_m23;
    float distanceToCamera = distance(positionWS, _CameraPositionWS);
    if (distanceToCamera > _MaximumDistance
        || !IsVisible(positionWS, _BoundingRadius))
        return;

    if (distanceToCamera <= _Lod0Distance)
        _VisibleLod0.Append(instance.localToWorld);
    else
        _VisibleLod1.Append(instance.localToWorld);
}
